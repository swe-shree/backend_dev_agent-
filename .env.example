# Copy to .env and adjust. Variables use the AGENT_ prefix.
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# Gemini. Get a key from Google AI Studio and put it only in your local .env (never commit it).
GEMINI_API_KEY=your-gemini-api-key-here
# AGENT_GEMINI_MODEL=gemini-3.5-flash-lite
# AGENT_GEMINI_TIMEOUT_SECONDS=30
# AGENT_GEMINI_MAX_PROMPT_CHARS=4000
# AGENT_GEMINI_MAX_OUTPUT_TOKENS=512
# AGENT_GEMINI_THINKING_BUDGET=
# AGENT_GEMINI_INPUT_PRICE_PER_MILLION_USD=
# AGENT_GEMINI_OUTPUT_PRICE_PER_MILLION_USD=

# Bug analysis context limits (per task sent to Gemini).
# AGENT_CONTEXT_MAX_FILES=6
# AGENT_CONTEXT_MAX_CHARS=12000
# AGENT_CONTEXT_WINDOW_LINES=12
# AGENT_CONTEXT_MAX_TERMS=5
# AGENT_MAX_MATCHES_PER_TERM=30
# AGENT_ANALYSIS_MAX_OUTPUT_TOKENS=1024

# Fix proposals (POST /agent/fix-proposal). Bounds for the single patch-generation call and the diff.
# AGENT_FIX_MAX_OUTPUT_TOKENS=1536
# AGENT_FIX_MAX_CONTEXT_CHARS=8000
# AGENT_FIX_MAX_FILES=3
# AGENT_FIX_MAX_HUNKS_PER_FILE=5
# AGENT_FIX_MAX_CHANGED_LINES=120
# AGENT_FIX_MAX_PATCH_CHARS=6000

# Repository analysis. Requests may only point at directories inside this root.
# Leave unset to disable the /repo endpoints.
# AGENT_ALLOWED_REPO_ROOT=C:\path\to\projects
# AGENT_MAX_FILE_BYTES=1000000
# AGENT_MAX_FILES=5000
# AGENT_MAX_SEARCH_RESULTS=200
# AGENT_GIT_TIMEOUT_SECONDS=10
# AGENT_MAX_GIT_OUTPUT_BYTES=200000
